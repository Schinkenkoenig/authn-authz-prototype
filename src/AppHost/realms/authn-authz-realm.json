{
  "realm": "authn-authz",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "reader",
        "description": "May read objects under their own prefix"
      },
      {
        "name": "writer",
        "description": "May read and write objects under their own prefix"
      },
      {
        "name": "incident_responder",
        "description": "Break-glass: may read any object when the request carries break_glass"
      }
    ]
  },
  "clients": [
    {
      "clientId": "webapp",
      "name": "SPA Front Door",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "level",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "level",
            "claim.name": "level",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "storage_grants",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "storage_grants",
            "claim.name": "storage_grants",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "storage-service",
      "name": "Storage Service (IRSA-style service identity)",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "storage-service-secret",
      "protocolMappers": [
        {
          "name": "storage-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "storage-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Finance",
      "credentials": [
        { "type": "password", "value": "alice", "temporary": false }
      ],
      "attributes": {
        "department": ["finance"],
        "level": ["2"],
        "storage_grants": ["r:finance/"]
      }
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Engineering",
      "credentials": [
        { "type": "password", "value": "bob", "temporary": false }
      ],
      "attributes": {
        "department": ["engineering"],
        "level": ["3"],
        "storage_grants": ["rw:projects/apollo/"]
      }
    },
    {
      "username": "carol",
      "enabled": true,
      "emailVerified": true,
      "email": "carol@example.com",
      "firstName": "Carol",
      "lastName": "HR",
      "credentials": [
        { "type": "password", "value": "carol", "temporary": false }
      ],
      "attributes": {
        "department": ["hr"],
        "level": ["1"],
        "storage_grants": ["r:hr/"]
      },
      "realmRoles": ["incident_responder"]
    },
    {
      "username": "dave",
      "enabled": true,
      "emailVerified": true,
      "email": "dave@example.com",
      "firstName": "Dave",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "dave", "temporary": false }
      ],
      "attributes": {
        "department": ["it"],
        "level": ["4"],
        "storage_grants": ["rw:*"]
      }
    },
    {
      "username": "erin",
      "enabled": true,
      "emailVerified": true,
      "email": "erin@example.com",
      "firstName": "Erin",
      "lastName": "Finance",
      "credentials": [
        { "type": "password", "value": "erin", "temporary": false }
      ],
      "attributes": {
        "department": ["finance"],
        "level": ["3"],
        "storage_grants": ["rw:finance/"]
      }
    }
  ]
}
